# Builds the static EvalSuite C library with cargo and links it. A source tarball carries the Rust sources and
# their vendored dependencies in src/rust (tools/vendor.sh) and builds offline; inside the repository the
# workspace in ../../../rust is used (or EVALSUITE_RUST_DIR).
VENDORED = $(wildcard rust/Cargo.toml)
RUST_DIR = $(if $(VENDORED),rust,$(or $(EVALSUITE_RUST_DIR),../../../rust))
CARGO_FLAGS = $(if $(VENDORED),--offline,)
TARGET_DIR = $(CURDIR)/rust-target

PKG_CPPFLAGS = -I$(RUST_DIR)/evalsuite-capi/include
PKG_LIBS = $(TARGET_DIR)/release/libevalsuite_c.a -lpthread -ldl -lm

$(SHLIB): rustlib

rustlib:
	cd $(RUST_DIR) && CARGO_TARGET_DIR=$(TARGET_DIR) CARGO_PROFILE_RELEASE_PANIC=unwind cargo build --release -p evalsuite-capi $(CARGO_FLAGS)

clean:
	rm -rf $(TARGET_DIR)

.PHONY: rustlib clean
